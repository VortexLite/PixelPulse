@model PixelPulse.Application.DTOs.Order.OrderUpdateDTO?

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

@section style
{
    <link rel="stylesheet" href="~/css/orderUpdate.css"/>
}

<main>
    <form method="post" asp-action="UpdateOrderAPI">
        <input type="text" asp-for="Id" placeholder="ID" value="@Model.Id" disabled>
        <input type="text" asp-for="AppUserId" value="@Model.AppUserId" placeholder="AppUserId" disabled />
        <input type="datetime" asp-for="OrderDate" placeholder="OrderDate" value="@Model.OrderDate" disabled />
        <input type="number" asp-for="TotalPrice" placeholder="TotalPrice" value="@Model?.TotalPrice" />
        <select class="status" asp-for="Status">
            <option value="Pending">Очікує</option>
            <option value="Processing">Обробка</option>
            <option value="Shipped">Відправлено</option>
            <option value="Delivered">Доставлено</option>
            <option value="Cancelled">Скасовано</option>
        </select>
        <h3>Товари в замовленні</h3>
        <table id="orderItemsTable">
            <thead>
                <tr>
                    <th>ID товара</th>
                    <th>Кількість</th>
                    <th>Ціна</th>
                    <th>Дія</th>
                </tr>
            </thead>
            <tbody>
            @if (Model?.OrderItems != null)
            {
                foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>
                            <input type="hidden" value="@item.Id"/>
                            <input type="hidden" value="@item.OrderId"/>
                            <input type="text" value="@item.ProductId" required/>
                        </td>
                        <td>
                            <input type="number" value="@item.Quantity" min="1" required/>
                        </td>
                        <td>
                            <input type="number" value="@item.Price" required/>
                        </td>
                        <td>
                            <a asp-action="DeleteOrderItem">❌</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>

        <a asp-action="AddOrderItem">➕</a>

        <button type="submit" >Зберегти</button>
    </form>
</main>
