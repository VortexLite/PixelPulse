@model List<PixelPulse.Application.DTOs.ViewSQL.ProductSalesSummaryView>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

@section style
{
    <link rel="stylesheet" href="~/css/viewstat.css"/>
}

<main>
    <table>
        <thead>
        <tr>
            <th>Назва товару</th>
            <th>Кількість</th>
            <th>Загальний дохід</th>
        </tr>
        </thead>
        <tbody id="userTableBody">
        @foreach (var data in Model)
        {
            <tr>
                <td>@data.ProductName</td>
                <td>@data.TotalQuantitySold</td>
                <td>@data.TotalRevenue</td>
            </tr>
        }
        </tbody>
    </table>
</main>