@model PixelPulse.Domain.Entities.Product

@{
    ViewBag.Title = "Створити товар";
    Layout = "_Layout";
}

@section style
{
    <link rel="stylesheet" href="~/css/productUpdate.css"/>
}

<main>
    <form asp-action="CreateProducAPI" method="post" enctype="multipart/form-data">
        <input type="text" asp-for="Id" placeholder="ID" disabled value="1">
        <input type="text" asp-for="Name" placeholder="Назва">
        <input type="text" asp-for="Description" placeholder="Опис">
        <input type="text" asp-for="OldPrice" placeholder="Стара ціна">
        <input type="text" asp-for="Price" placeholder="Ціна">
        <input type="text" asp-for="Stock" placeholder="Кількість">
        <input type="text" asp-for="CategoryId" placeholder="Категорія">
        <input type="text" asp-for="SupplierId" placeholder="Постачальник">
        <input type="file" asp-for="ProductImages" placeholder="Фото" multiple>

        <button type="submit">Зберегти</button>
    </form>
</main>
