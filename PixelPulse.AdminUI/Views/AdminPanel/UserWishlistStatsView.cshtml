@model List<PixelPulse.Application.DTOs.ViewSQL.UserWishlistStatsView>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

@section style
{
    <link rel="stylesheet" href="~/css/viewstat.css"/>
}

<main>
    <table>
        <thead>
        <tr>
            <th>Ім'я</th>
            <th>Прізвище</th>
            <th>Кількість товарів у вішлісті</th>
        </tr>
        </thead>
        <tbody id="userTableBody">
        @foreach (var data in Model)
        {
            <tr>
                <td>@data.FirstName</td>
                <td>@data.LastName</td>
                <td>@data.WishlistCount</td>
            </tr>
        }
        </tbody>
    </table>
</main>