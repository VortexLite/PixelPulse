<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - PixelPulse</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <meta name="theme-color" content="#03b7d8">
    <meta name="description" content="PixelPulse online electronics store">
    <meta name="robots" content="index,follow">
    <meta name="googlebot" content="index,follow">
    <meta name="generator" content="ASP.NET CORE">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="icon" sizes="192x192" href="/path/to/icon.png">
    <link rel="apple-touch-icon" href="/path/to/apple-touch-icon.png">
    <link rel="mask-icon" href="/path/to/icon.svg" color="blue">
    
    @await RenderSectionAsync("style", required: false)
    <title>PixelPulse</title>
    <link rel="stylesheet" href="user.css">
</head>
<body>
    <header>
        <span class="logo"><a asp-action="Index">PixelPulse</a></span>
    </header>
    @RenderBody()
    <footer>
        <span class="footerText">&copy Всі ваші права захищено.</span>
        <a href="https://shorturl.at/rkVM3" class="linkConfidence">
            <span>Політика конфеденційності.</span>
        </a>
    </footer>
    @await RenderSectionAsync("script", required: false)
</body>
</html>