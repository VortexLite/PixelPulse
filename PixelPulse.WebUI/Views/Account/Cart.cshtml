@model List<PixelPulse.Application.DTOs.Cart.CartItemDTO>?

@{
    ViewBag.Title = "Cart";
    Layout = "_Layout";
}

<main>
    <div class="customerCart">
        <h1>Cart</h1>
        <div>
            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
            </svg>
            <img src="testCardImage.webp">
            <span class="cartName">SAMSUNG Galaxy S24 Ultra 12/512Gb Titanium Black (SM-S928BZKHEUC)</span>
            <input type="number" name="counter" required value="0">
            <span class="cartDiscount">97 999 ₴</span>
            <span class="cartPrice">88 499 ₴</span>
        </div>
        @foreach (var cartItem in Model)
        {
            <div>
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                </svg>
                @if (cartItem.ImageData != null)
                {
                    <img src="data:@cartItem.ImageType;base64,@Convert.ToBase64String(cartItem.ImageData)" class="productImage" alt="@cartItem.ProductName">
                }
                else
                {
                    <img src="~/images/Null.webp" class="productImage" alt="@cartItem.ProductName">
                }
                <span class="cartName">@cartItem.ProductName</span>
                <input type="number" name="counter" required value="@cartItem.Quantity">
                <span class="cartDiscount">@cartItem.OldPrice.ToString("N1") ₴</span>
                <span class="cartPrice">@cartItem.Price.ToString("N1") ₴</span>
            </div>
        }

        <div class="placeOrder">
            <span>Разом: @Model.Sum(k => k.Price) ₴</span>
            <button type="submit">Оформити замовлення</button>
        </div>
    </div>
</main>
