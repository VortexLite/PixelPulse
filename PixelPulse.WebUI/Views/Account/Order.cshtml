@model List<PixelPulse.Application.DTOs.Order.OrderDTO>?

@{
    ViewBag.Title = "Замовлення";
    Layout = "_Layout";
}

@section styles
{
    <link rel="stylesheet" href="~/css/account.css"/>
}

@section script
{
    <script src="~/js/account Order.js"></script>
}

<main>
    <ul class="customerTab">
        <li>
            <a asp-action="Personal_Information">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-width="2" d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                </svg>
                <span>Персональна інформація</span>
            </a>
        </li>
        <li>
            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M9 8h10M9 12h10M9 16h10M4.99 8H5m-.02 4h.01m0 4H5"/>
            </svg>
            <span>Замовлення</span>
        </li>
        <li>
            <a asp-action="Cart">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h1.5L9 16m0 0h8m-8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8.5-3h9.25L19 7H7.312"/>
                </svg>
                <span>Корзина</span>
            </a>
        </li>
        <li>
            <a asp-action="Wishlist">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.01 6.001C6.5 1 1 8 5.782 13.001L12.011 20l6.23-7C23 8 17.5 1 12.01 6.002Z"/>
                </svg>
                <span>Список бажань</span>
            </a>
        </li>
        <li>
            <a asp-action="Review">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 10.5h.01m-4.01 0h.01M8 10.5h.01M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-6.6a1 1 0 0 0-.69.275l-2.866 2.723A.5.5 0 0 1 8 18.635V17a1 1 0 0 0-1-1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>
                </svg>
                <span>Відгуки</span>
            </a>
        </li>
        <li>
            <a asp-action="Logout">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H8m12 0-4 4m4-4-4-4M9 4H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h2"/>
                </svg>
                <span>Вихід</span>
            </a>
        </li>
    </ul>
    <div class="customerOrders">
        <h1>Замовлення</h1>
        <table>
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Дата</th>
                    <th>Кількість товарів</th>
                    <th>Сума</th>
                    <th>Статус</th>
                    <th>Відгук</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr class="order-row">
                        <td>№@order.Id</td>
                        <td>@order.OrderDate.ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@order.TotalItems шт</td>
                        <td>@order.TotalPrice.ToString("N1") ₴</td>
                        <td>@order.Status</td>
                        <td>
                            <button>Залишити відгук</button>
                        </td>
                        <td>
                            <a asp-action="CancelOrder">
                                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                                </svg>
                            </a>
                        </td>
                    </tr>
                    <tr class="customerOrdersDetails hidden">
                        <td></td>
                        <td colspan="2">Назва</td>
                        <td>Сума</td>
                        <td>Кількість</td>
                        <td colspan="3">Загальна сума</td>
                    </tr>
                    if (order.OrderItems != null)
                    {
                        foreach (var orderItem in order.OrderItems)
                        {
                            <tr class="customerOrdersDetails hidden">
                                <td>
                                    @*@if (orderItem.ImageData != null)
                                    {
                                        <img src="data:@orderItem.ImageType;base64,@orderItem.ImageData" class="productImage" alt="@orderItem.ProductName">
                                    }
                                    else
                                    {
                                        <img src="~/images/Null.webp" class="productImage" alt="@orderItem.ProductName">
                                    }*@
                                    <img src="@orderItem.ImagePath" class="productImage" alt="@orderItem.ProductName">
                                </td>
                                <td colspan="2">@orderItem.ProductName</td>
                                <td>@orderItem.ProductPrice ₴</td>
                                <td>@orderItem.Quantity шт</td>
                                <td colspan="3">@(orderItem.ProductPrice * orderItem.Quantity) ₴</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</main>
