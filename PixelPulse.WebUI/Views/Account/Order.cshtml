@model List<PixelPulse.Application.DTOs.Order.OrderDTO>?

@{
    ViewBag.Title = "Order";
    Layout = "_Layout";
}

<main>
    <div class="customerOrders">
        <h1>My orders</h1>
        <table>
            <thead>
            <tr>
                <th>Номер</th>
                <th>Дата</th>
                <th>Кількість товарів</th>
                <th>Сума</th>
                <th>Статус</th>
                <th>Тип доставки</th>
                <th>Відгук</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>№304442849</td>
                <td>10.10.2024</td>
                <td>1шт</td>
                <td>1 399 ₴</td>
                <td>Отримано</td>
                <td>Самовивіз</td>
                <td><button>Залишити відгук</button></td>
            </tr>
            @foreach (var order in Model)
            {
                <tr>
                    <td>№@order?.Id</td>
                    <td>@order?.OrderDate.ToString("dd.MM.yyyy, HH:mm")</td>
                    <td>@order?.TotalItems шт</td>
                    <td>@order?.TotalPrice.ToString("N1") ₴</td>
                    <td>@order?.Status</td>
                    <td>@order?.Shipping</td>
                    <td><button>Залишити відгук</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</main>
