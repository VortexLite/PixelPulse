@model List<PixelPulse.Application.DTOs.Wishlist.WishlistItemDTO>?

@{
    ViewBag.Title = "Список бажань";
    Layout = "_Layout";
}

@section styles
{
	<link rel="stylesheet" href="~/css/account.css"/>
}

<main>
	<ul class="customerTab">
		<li>
			<a asp-action="Personal_Information">
				<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<path stroke="currentColor" stroke-width="2" d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
				</svg>
				<span>Персональна інформація</span>
			</a>
		</li>
		<li>
			<a asp-action="Order">
				<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M9 8h10M9 12h10M9 16h10M4.99 8H5m-.02 4h.01m0 4H5"/>
				</svg>
				<span>Замовлення</span>
			</a>
		</li>
		<li>
			<a asp-action="Cart">
				<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h1.5L9 16m0 0h8m-8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8.5-3h9.25L19 7H7.312"/>
				</svg>
				<span>Корзина</span>
			</a>
		</li>
		<li>
			<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.01 6.001C6.5 1 1 8 5.782 13.001L12.011 20l6.23-7C23 8 17.5 1 12.01 6.002Z"/>
			</svg>
			<span>Список бажань</span>
		</li>
		<li>
			<a asp-action="Review">
				<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 10.5h.01m-4.01 0h.01M8 10.5h.01M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-6.6a1 1 0 0 0-.69.275l-2.866 2.723A.5.5 0 0 1 8 18.635V17a1 1 0 0 0-1-1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>
				</svg>
				<span>Відгуки</span>
			</a>
		</li>
		<li>
			<a asp-action="Logout">
				<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H8m12 0-4 4m4-4-4-4M9 4H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h2"/>
				</svg>
				<span>Вихід</span>
			</a>
		</li>
	</ul>
    <div class="customerWishlist">
        <h1>Список бажань</h1>
        <div class="randomProductList">
            @foreach (var wishlistItem in Model)
            {
	            <div class="productCard">
		            @*@if (wishlistItem.ImageData != null)
		            {
			            <img src="data:@wishlistItem.ImageType;base64,@wishlistItem.ImageData" class="productImage" alt="@wishlistItem.ProductName">
		            }
		            else
		            {
			            <img src="~/images/Null.webp" class="productImage" alt="@wishlistItem.ProductName">
		            }*@
		            <img src="@wishlistItem.ImagePath" class="productImage" alt="@wishlistItem.ProductName">
	                <div class="productInfo">
	                    <p>@wishlistItem.ProductName</p>
	                </div>
	                <div class="productReview">
		                <span>
			                @for (var i = 0; i < 5; i++)
			                {
				                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					                <path stroke="currentColor" stroke-width="2" d="M11.083 5.104c.35-.8 1.485-.8 1.834 0l1.752 4.022a1 1 0 0 0 .84.597l4.463.342c.9.069 1.255 1.2.556 1.771l-3.33 2.723a1 1 0 0 0-.337 1.016l1.03 4.119c.214.858-.71 1.552-1.474 1.106l-3.913-2.281a1 1 0 0 0-1.008 0L7.583 20.8c-.764.446-1.688-.248-1.474-1.106l1.03-4.119A1 1 0 0 0 6.8 14.56l-3.33-2.723c-.698-.571-.342-1.702.557-1.771l4.462-.342a1 1 0 0 0 .84-.597l1.753-4.022Z"/>
				                </svg>
			                }
			            </span>
		                <span>
			                <a asp-action="DeleteWishlistItem" asp-route-wishlistItemId="@wishlistItem.Id" class="pointer">
	                            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
	                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.01 6.001C6.5 1 1 8 5.782 13.001L12.011 20l6.23-7C23 8 17.5 1 12.01 6.002Z"/>
	                            </svg>
	                        </a>
						</span>
	                </div>
	                <div class="productDiscount">
	                    <span>@wishlistItem.OldPrice</span>
	                    <span>-@(wishlistItem.OldPrice - wishlistItem.Price)</span>
	                </div>
	                <div class="productFooter">
	                    <span class="priceProduct">@wishlistItem.Price ₴</span>
	                    <button class="cartProduct">
		                    <a asp-action="DeleteWishlistItem" asp-route-wishlistItemId="@wishlistItem.Id" class="pointer">
			                    <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
				                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h1.5L9 16m0 0h8m-8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8.5-3h9.25L19 7H7.312"/>
			                    </svg>
		                    </a>
	                    </button>
	                </div>
	            </div>
            }
        </div>
    </div>
</main>
