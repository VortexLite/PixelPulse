@model List<PixelPulse.Application.DTOs.Review.ReviewDTO>?

@{
    ViewBag.Title = "Review";
    Layout = "_Layout";
}

<main>
    <div class="customerReview">
        <h1>Review</h1>
        <div>
            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                 fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M6 18 17.94 6M18 18 6.06 6"/>
            </svg>

            <img src="testCardImage.webp">
            <span class="reviewName">SAMSUNG Galaxy S24 Ultra 12/512Gb Titanium Black (SM-S928BZKHEUC)</span>
            <span class="reviewMessage">Дуже сподобалися. Не лагають, працюють швидко. Але великуваті</span>
            <button>Good</button>
        </div>
       @foreach (var review in Model)
        {
            <div>
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                </svg>

                @if (review.ImageData != null)
                {
                    <img src="data:@review.ImageType;base64,@Convert.ToBase64String(review.ImageData)" class="productImage" alt="@review.ProductName">
                }
                else
                {
                    <img src="~/images/Null.webp" class="productImage" alt="@review.ProductName">
                }
                <span class="reviewName">@review.ProductName</span>
                <span class="reviewMessage">@review.Comment</span>
                <button>Good</button>
            </div>
        }
    </div>
</main>
