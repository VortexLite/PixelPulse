@model PixelPulse.Application.DTOs.Product.ProductCategoryDTO?

@{
    ViewBag.Title = "Monitor";
    Layout = "_Layout";
}

@section styles
{
    <link rel="stylesheet" href="~/css/product.css"/>
}

<main>
    <div class="productDetail">
        @if (Model.ProductImages.Any())
        {
            foreach (var image in Model.ProductImages)
            {
                if (image.ImageData != null)
                {
                    <img src="data:@image.ImageType;base64,@image.ImageData" class="productImage" alt="@Model.Name">
                }
                else
                {
                    <img src="/images/Null.webp" class="productImage" alt="@Model.Name">
                }
            }
        }
        else
        {
            <img src="/images/Null.webp" class="productImage" alt="@Model.Name">
        }
        <div class="productInfo">
            <h2 class="productName">@Model.Name</h2>
            <span class="productDescription">@Model.Description</span>
            <h3 class="productCharacteristic">Характеристика</h3>
            <ul class="productSpecs">
                <li>Дисплей: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Дисплей")?.Value ?? "-")</span></li>
                <li>Частота оновлення: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Частота оновлення")?.Value ?? "-")</span></li>
                <li>Максимальна яскравість: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Максимальна яскравість")?.Value ?? "-")</span></li>
                <li>Регулювання по висоті (мм): <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Регулювання по висоті (мм)")?.Value ?? "-")</span></li>
                <li>Відеоінтерфейси: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Відеоінтерфейси")?.Value ?? "-")</span></li>
            </ul>
            <div class="productPriceBtn">
                <span class="productPrice">Ціна: <span>@Model.Price ₴</span></span>
                @if (Model.Stock != 0)
                {
                    <button class="addToCart">Додати в кошик</button>
                }
                else
                {
                    <button class="addToCart" disabled>Додати в кошик</button>
                }
            </div>
        </div>
    </div>
    <div class="productCharacteristicFull">
        <h3>Характеристики</h3>
        <table class="productTable">
            <tbody>
                @{
                    string? lastCategory = null;
                }
                @foreach (var spec in Model.ProductSpecifications.OrderBy(s => s.Category))
                {
                    if (lastCategory != spec.Category)
                    {
                        <tr>
                            <td colspan="2">
                                <h3 class="borderTopCharacteristicFull">@spec.Category</h3>
                            </td>
                        </tr>
                        lastCategory = spec.Category;
                    }
                    <tr>
                        <td>@spec.Name: </td>
                        <td>@spec.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
