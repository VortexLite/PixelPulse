@model TModel

@{
    ViewBag.Title = "Mouse";
    Layout = "_Layout";
}

@section styles
{
    <link rel="stylesheet" href="~/css/product.css"/>
}

<main>
    <div class="productDetail">
        <img src="testMouse.png">
        <div class="productInfo">
            <h2 class="productName">Миша Logitech G Pro X Superlight 2 Lightspeed Wireless Black (910-006630)</h2>
            <span class="productDescription">Logitech G Pro X Superlight 2 - це ультралегка ігрова миша, призначена для професійних геймерів, які прагнуть максимальної точності та швидкості. З вагою всього 60 грам, вона забезпечує неймовірну легкість і плавність рухів. Миша використовує передову бездротову технологію Lightspeed, яка забезпечує надійне і швидке з'єднання без затримок, що критично важливо в динамічних іграх. Оснащена сенсором Hero 2 з роздільною здатністю до 32 000 DPI, вона забезпечує точне відстеження навіть найдрібніших рухів, що робить її чудовим вибором для кіберспортсменів. Також Logitech G Pro X Superlight 2 підтримує налаштування DPI через фірмове програмне забезпечення G HUB, даючи змогу геймерам адаптувати мишу під свої уподобання. Миша має просту й ергономічну конструкцію з 5 програмованими кнопками, що дає змогу налаштовувати її під конкретні завдання. Зарядка здійснюється через кабель з інтерфейсом USB-C, що забезпечує швидке і зручне заряджання. Одного повного заряду Logitech G Pro X Superlight 2 вистачає на довгий час інтенсивної гри завдяки енергоефективним рішенням від Logitech.
				</span>
            <h3 class="productCharacteristic">Характеристика</h3>
            <ul class="productSpecs">
                <li>Миша: <span>для настільних ПК, для ігор</span></li>
                <li>Підключення: <span>радіоінтерфейс</span></li>
                <li>Сенсор: <span>оптичний</span></li>
                <li>Роздільна здатність: <span>32000</span></li>
            </ul>
            <div class="productPriceBtn">
                <span class="productPrice">Ціна: <span>58 899 ₴</span></span>
                <button class="addToCart">Додати в кошик</button>
            </div>
        </div>
    </div>
    <div class="productCharacteristicFull">
        <h3>Характеристики</h3>
        <table class="productTable">
            <tbody>
            <tr>
                <td>Бренд:</td>
                <td>Logitech</td>
            </tr>
            <tr>
                <td>Тип:</td>
                <td>Миша</td>
            </tr>
            <tr>
                <td>Призначення:</td>
                <td>для настільних ПК, для ігор</td>
            </tr>
            <tr>
                <td>Бездротове підключення:</td>
                <td>є</td>
            </tr>
            <tr>
                <td>Інтерфейс комунікації з ПК:</td>
                <td>радіоінтерфейс</td>
            </tr>
            <tr>
                <td>Живлення маніпулятора (для бездротових):</td>
                <td>вбудований акумулятор</td>
            </tr>
            <tr>
                <td>Колір корпусу:</td>
                <td>чорний</td>
            </tr>
            <tr>
                <td colspan="2">
                    <h3 class="borderTopCharacteristicFull">Миша</h3>
                </td>
            </tr>
            <tr>
                <td>Конструкція корпусу:</td>
                <td>Ергономічний</td>
            </tr>
            <tr>
                <td>Тип сенсора:</td>
                <td>оптичний</td>
            </tr>
            <tr>
                <td>Роздільна здатність, dpi:</td>
                <td>32000</td>
            </tr>
            <tr>
                <td>Розмір миші, мм:</td>
                <td>125x63,5x40</td>
            </tr>
            <tr>
                <td>Вага миші, г:</td>
                <td>60</td>
            </tr>
            </tbody>
        </table>
    </div>
</main>
