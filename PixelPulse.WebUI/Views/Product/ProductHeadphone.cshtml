@model PixelPulse.Application.DTOs.Product.ProductCategoryDTO?

@{
    ViewBag.Title = "Headphone";
    Layout = "_Layout";
}

@section styles
{
    <link rel="stylesheet" href="~/css/product.css"/>
}

@section script
{
    <script>
        @*const images = [
            "testHeadphone.png",
            "testKeyboard.png",
            "testLaptop.png",
            "testMonitor.png",
            "testMouse.png"
        ];*@
        
        const images = @Html.Raw(Json.Serialize(Model?.ProductImages));

        let currentIndex = 0;
        const imgElement = document.getElementById("productImage");
        const prevBtn = document.querySelector(".prev");
        const nextBtn = document.querySelector(".next");

        prevBtn.addEventListener("click", () => {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            imgElement.src = images[currentIndex];
        });

        nextBtn.addEventListener("click", () => {
            currentIndex = (currentIndex + 1) % images.length;
            imgElement.src = images[currentIndex];
        });
    </script>
}

<main>
    <div class="productDetail">
        @if (Model.ProductImages.Any())
        {
            <div class="image-container">
                <button class="prev">◀</button>
                @if (Model.ProductImages.FirstOrDefault(pi => pi.isMain == true).ImageData != null)
                {
                    <img src="data:@Model.ProductImages.FirstOrDefault(pi => pi.isMain == true).ImageType;base64,@Model.ProductImages.FirstOrDefault(pi => pi.isMain == true).ImageData)" class="productImage" alt="@Model.Name">
                }
                else
                {
                    <img src="/images/Null.webp" class="productImage" alt="@Model.Name">
                }
                <button class="next">▶</button>
            </div>
            
            @*foreach (var image in Model.ProductImages)
            {
                if (image.ImageData != null)
                {
                    <img src="data:@image.ImageType;base64,@Convert.ToBase64String(image.ImageData)" class="productImage" alt="@Model.Name">
                }
                else
                {
                    <img src="/images/Null.webp" class="productImage" alt="@Model.Name">
                }
            }*@
        }
        else
        {
            <img src="/images/Null.webp" class="productImage" alt="@Model.Name">
        }
        <div class="productInfo">
            <h2 class="productName">@Model.Name</h2>
            <span class="productDescription">@Model.Description</span>
            <h3 class="productCharacteristic">Характеристика</h3>
            <ul class="productSpecs">
                <li>Спосіб підключення: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Спосіб підключення")?.Value ?? "-")</span></li>
                <li>Конструкція: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Конструкція")?.Value ?? "-")</span></li>
                <li>Акустичне оформлення: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Акустичне оформлення")?.Value ?? "-")</span></li>
                <li>Складана конструкція: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Складана конструкція")?.Value ?? "-")</span></li>
                <li>Випромінювач: <span>@(Model.ProductSpecifications.FirstOrDefault(ps => ps.Name == "Випромінювач")?.Value ?? "-")</span></li>
            </ul>
            <div class="productPriceBtn">
                <span class="productPrice">Ціна: <span>@Model.Price ₴</span></span>
                @if (Model.Stock != 0)
                {
                    <button class="addToCart">Додати в кошик</button>
                }
                else
                {
                    <button class="addToCart" disabled>Додати в кошик</button>
                }
            </div>
        </div>
    </div>
    <div class="productCharacteristicFull">
        <h3>Характеристики</h3>
        <table class="productTable">
            <tbody>
                @{
                    string? lastCategory = null;
                }
                @foreach (var spec in Model.ProductSpecifications.OrderBy(s => s.Category))
                {
                    if (lastCategory != spec.Category)
                    {
                        <tr>
                            <td colspan="2">
                                <h3 class="borderTopCharacteristicFull">@spec.Category</h3>
                            </td>
                        </tr>
                        lastCategory = spec.Category;
                    }
                    <tr>
                        <td>@spec.Name: </td>
                        <td>@spec.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
